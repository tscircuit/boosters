{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "types": [
      "tscircuit"
    ]
  },
  "include": [
    "boostxl-edumkii/**/*.ts",
    "boostxl-edumkii/**/*.tsx",
    "boost-drv8848/**/*.ts",
    "boost-drv8848/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".claude",
    "**/__snapshots__"
  ]
}
