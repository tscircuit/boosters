{
  "name": "@tsci/tscircuit.boosters",
  "version": "0.1.0",
  "description": "A multi-board collection of TI LaunchPad BoosterPack designs built with tscircuit",
  "main": "dist/index.js",
  "keywords": [
    "tscircuit",
    "ti",
    "launchpad",
    "boosterpack",
    "pcb"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --ci --concurrency 4 --autorouter-timeout 600s",
    "build:ci": "tsci build --ci --concurrency 4 --autorouter-timeout 600s",
    "snapshot": "tsci snapshot '{boostxl-edumkii,boost-drv8848,boostxl-bassensors,boostxl-audio,boostxl-cc2650ma}/index.circuit.tsx'",
    "snapshot:update": "bun run snapshot --update",
    "start": "tsci dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "bun-types": "^1.4.2",
    "tscircuit": "^0.0.2292",
    "typescript": "^5.0.0"
  },
  "author": "tscircuit",
  "license": "MIT"
}
